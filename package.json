{
  "name": "typenhebel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --fail-on-warnings && vite build",
    "check": "svelte-check --fail-on-warnings",
    "preview": "vite preview",
    "test": "vitest run",
    "test:proto": "node prototype/tests/core.test.mjs prototype/index.html",
    "e2e": "playwright test",
    "lint": "eslint . && prettier --check . && svelte-check --fail-on-warnings",
    "format": "prettier --write .",
    "corpus": "node scripts/corpus.mjs",
    "sounds": "node scripts/sounds.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "fflate": "^0.8.3"
  }
}
